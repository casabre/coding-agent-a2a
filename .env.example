# HTTP port the server listens on (A2A always available on this port)
PORT=41242

# Coding agent adapter: cursor | claude-code | vibe | codex | opencode | generic
AGENT_ADAPTER=cursor

# Optional: override the agent binary path
# CURSOR_AGENT_PATH=/path/to/cursor-agent
# CLAUDE_CODE_PATH=/path/to/claude
# VIBE_BINARY_PATH=/path/to/vibe
# CODEX_BINARY_PATH=/path/to/codex
# OPENCODE_BINARY_PATH=/path/to/opencode

# Generic adapter settings (when AGENT_ADAPTER=generic)
# AGENT_BINARY=/path/to/your-agent
# AGENT_ARGS=--stream --model my-model
# AGENT_APPROVAL_PATTERN=\[Y\/n\]
# AGENT_APPROVAL_RESPONSE=yes

# Optional: model override (e.g. claude-sonnet-4-5)
AGENT_MODEL=

# Hard timeout per task in ms (0 = disabled)
AGENT_TIMEOUT_MS=120000

# Idle-kill threshold in ms (0 = disabled)
AGENT_IDLE_EXIT_MS=0

# Pass -f / --dangerously-skip-permissions to skip shell approval prompts
AGENT_FORCE=true

# Working directory passed to agent as cwd
AGENT_REPO_PATH=.

# Transport mode for MCP protocol surface
# stdio  — Claude Desktop spawns this process directly (recommended for local use)
# http   — Claude Desktop connects via URL; also works for remote deployments
MCP_TRANSPORT=stdio

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Optional: path to a JSON config file (env vars always win over file values)
# CONFIG_FILE=/etc/coding-agent/config.json

# ── Authentication ──────────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to protect /a2a/jsonrpc and (when MCP_TRANSPORT=http) /mcp
# with OAuth 2.0 Bearer tokens. Default: false (no auth, suitable for local dev).
AUTH_ENABLED=false

# OIDC provider discovery URL (recommended — auto-fills the three URLs below)
# AUTH_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration

# Manual overrides (required when AUTH_ENABLED=true and no AUTH_OIDC_DISCOVERY_URL)
# AUTH_AUTHORIZATION_URL=https://idp.example.com/authorize
# AUTH_TOKEN_URL=https://idp.example.com/token
# AUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json

# Token validation (required when AUTH_ENABLED=true)
# AUTH_ISSUER=https://idp.example.com
# AUTH_AUDIENCE=coding-agent

# Optional: comma-separated scopes required on incoming tokens (e.g. agent:run)
# AUTH_REQUIRED_SCOPES=

# OAuth server URLs for MCP OAuth metadata endpoints
# AUTH_SERVER_URL defaults to http://localhost:PORT (localhost exempt from HTTPS in dev)
# AUTH_RESOURCE_URL defaults to http://localhost:PORT/mcp
# AUTH_SERVER_URL=https://your-server.example.com
# AUTH_RESOURCE_URL=https://your-server.example.com/mcp

# Optional: comma-separated allowed redirect URIs for OAuth clients
# If unset, redirect URI validation is delegated to the IdP
# AUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
